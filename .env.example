# Variables d'environnement front (exposées au client via Vite → NON secrètes).
# Copiez ce fichier en `.env` et renseignez les valeurs de votre projet.
# Les secrets (SUPABASE_SERVICE_ROLE_KEY, VAPID_PRIVATE_KEY, identifiants SMS…)
# ne doivent JAMAIS figurer ici : ils vivent uniquement dans les secrets
# Supabase (Edge Functions) / de l'hébergeur.

# URL du projet Supabase
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_URL="https://<project-ref>.supabase.co"

# Clé publiable (anon) Supabase — publique par design (livrée au navigateur ;
# la sécurité repose sur la RLS, pas sur le secret de cette clé).
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# Clé VAPID PUBLIQUE (pushManager.subscribe) — non secrète. Doit correspondre à
# la clé privée VAPID configurée côté secrets Supabase.
VITE_VAPID_PUBLIC_KEY="<vapid-public-key>"
